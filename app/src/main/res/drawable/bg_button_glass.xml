<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <layer-list>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <solid android:color="@color/color_glass_fill_elevated"/>
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="@color/color_glass_border"/>
                    <solid android:color="@android:color/transparent"/>
                </shape>
            </item>

        </layer-list>
    </item>

    <!-- Default -->
    <item>
        <layer-list>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <solid android:color="@color/color_glass_fill"/>
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="@color/color_glass_border"/>
                    <solid android:color="@android:color/transparent"/>
                </shape>
            </item>

        </layer-list>
    </item>

</selector>