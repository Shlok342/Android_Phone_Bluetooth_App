<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rename_device"
        android:textColor="#F3F4F8"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/give_your_device_a_cleaner_custom_name"
        android:textColor="#AEB4C2"
        android:textSize="13sp"
        android:fontFamily="sans-serif"/>

    <EditText
        android:id="@+id/editNameInput"

        android:layout_width="320dp"
        android:layout_height="56dp"

        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"

        android:background="@drawable/bg_edit_text_luxury"

        android:hint = "@string/hint_for_rename_option"


        android:textColor="#F5F7FA"
        android:textColorHint="#6F7684"
        android:textSize="15sp"

        android:paddingStart="18dp"
        android:paddingEnd="18dp"

        android:fontFamily="sans-serif-medium"
        android:inputType="textCapWords"
        android:maxLines="1"

        android:importantForAutofill="no"
        android:autofillHints=""
        android:imeOptions="actionDone"

        android:backgroundTint="@android:color/transparent"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearAllCustomNames"
        android:layout_width="wrap_content"
        android:layout_height="36dp"

        android:layout_marginTop="14dp"
        android:layout_gravity="end"

        android:text="Clear All"
        android:textAllCaps="false"

        android:textSize="12sp"
        android:textStyle="bold"

        android:minWidth="0dp"
        android:minHeight="0dp"

        android:paddingStart="14dp"
        android:paddingEnd="14dp"

        android:insetTop="0dp"
        android:insetBottom="0dp"

        android:textColor="#FFD7D7"

        app:backgroundTint="#A94444"

        app:cornerRadius="12dp"

        elevation="0dp"/>

</LinearLayout>