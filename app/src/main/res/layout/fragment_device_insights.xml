<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_surface">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/insightsTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="@color/color_state_idle"
        app:tabSelectedTextColor="@color/color_text_primary"
        app:tabTextColor="@color/color_text_secondary"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Caption"
        app:tabBackground="@color/color_surface" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/insightsViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
