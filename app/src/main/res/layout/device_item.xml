<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:padding="12dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/deviceIndicator"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_indicator_dot"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/deviceName"
                android:text="@string/device_name"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/color_text_primary"
                android:letterSpacing="0.01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/deviceAddress"
                android:text="@string/device_address"
                android:textSize="11sp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/color_text_secondary"
                android:letterSpacing="0.04"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/deviceSignal"
                android:text="@string/device_signal"
                android:textSize="10sp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/color_text_tertiary"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <Button

            android:id="@+id/connectBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"

            android:minHeight="0dp"
            android:minWidth="0dp"

            android:text="@string/connect"
            android:textAllCaps="false"

            android:textColor="@color/color_text_primary"
            android:textSize="11sp"

            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"

            android:background="@drawable/bg_connect_btn"

            android:paddingStart="12dp"
            android:paddingEnd="12dp"

            android:insetTop="0dp"
            android:insetBottom="0dp"

            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>