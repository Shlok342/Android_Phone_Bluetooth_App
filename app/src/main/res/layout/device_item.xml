<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/deviceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"

        android:elevation="3dp"
        android:padding="12dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/deviceIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_indicator_dot"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/deviceName"
                android:text="@string/device_name"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/color_text_primary"
                android:letterSpacing="0.01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/deviceAddress"
                android:text="@string/device_address"
                android:textSize="11sp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/color_text_secondary"
                android:letterSpacing="0.04"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/deviceSignal"
                android:text="@string/device_signal"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/color_text_tertiary"
                android:layout_marginTop="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/connect"
            android:textAllCaps="false"
            android:textColor="@color/color_text_primary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:background="@drawable/bg_connect_btn"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null" />
        <ImageButton
            android:id="@+id/forgetBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/baseline_delete_forever_24"
            android:background="@drawable/bg_edit_pen"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="Forget device"
            android:stateListAnimator="@null" />
        <ImageButton
            android:id="@+id/editNameBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_edit_pen"
            android:background="@drawable/bg_edit_pen"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/edit_device_name"
            android:stateListAnimator="@null" />

        <ImageButton
            android:id="@+id/starBtn"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_star_outline"
            android:background="@drawable/bg_star_btn"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/favorite_device"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>